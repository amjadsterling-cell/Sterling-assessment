# Supabase (Settings -> API in your own Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transcription — console.groq.com (free tier)
GROQ_API_KEY=

# Report writer — aistudio.google.com (enable billing for real volume)
GEMINI_API_KEY=

# Optional — used to build absolute assessment links; falls back to request host
NEXT_PUBLIC_APP_URL=

# Any random string — protects /api/cron/self-heal from public calls
CRON_SECRET=
